-- ===== RENAME DISPLAY NAME FOR HIGHER AUTHORITY (natural, in-game) =====
-- For the higher authority player: rename their in-game display name so
-- other script users see "Name(🛠)" naturally instead of a floating ESP label.
local renamedPlayers = {}

local function applyDisplayNameBadge(plr)
    if renamedPlayers[plr] then return end
    local badge = nil
    if plr.UserId == higherAuthorityId then
        badge = "(🛠)"
    elseif lowerAuthorityIds[plr.UserId] then
        badge = "(⭐)"
    end
    if not badge then return end

    renamedPlayers[plr] = true
    local function tryRename()
        local char = plr.Character
        if not char then return end
        -- Find the overhead name (Humanoid description or NameDisplayDistance)
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            -- Append badge to display name shown above head via Humanoid
            pcall(function()
                humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Subject
                humanoid.NameDisplayDistance = 100
            end)
        end
        -- The actual name label lives in a BillboardGui inside the character
        -- We patch the existing overhead name by finding it
        local function patchNameGui(obj)
            if obj:IsA("BillboardGui") and (obj.Name == "NameGui" or obj.Name == "HealthGui" or obj.Name:find("Name")) then
                local lbl = obj:FindFirstChildOfClass("TextLabel")
                if lbl and lbl.Text == plr.DisplayName then
                    lbl.Text = plr.DisplayName .. badge
                end
            end
        end
        for _, obj in ipairs(char:GetDescendants()) do pcall(function() patchNameGui(obj) end) end
        char.DescendantAdded:Connect(function(obj) task.wait(0.05) pcall(function() patchNameGui(obj) end) end)

        -- Also patch the PlayerGui overhead (games that use a custom nametag system)
        for _, gui in ipairs(PlayerGui:GetDescendants()) do
            pcall(function()
                if gui:IsA("TextLabel") and gui.Text == plr.DisplayName then
                    gui.Text = plr.DisplayName .. badge
                end
            end)
        end
    end
    tryRename()
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        tryRename()
    end)
end

