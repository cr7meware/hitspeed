local spinAngle = 0
local isSpinning = false

local function spinToggleBtn()
    if isSpinning then return end
    isSpinning = true
    task.spawn(function()
        local steps = 12
        local totalAngle = 360
        local stepAngle = totalAngle / steps
        local stepTime = 0.018
        for i = 1, steps do
            spinAngle = spinAngle + stepAngle
            -- Roblox TextButton doesn't support Rotation directly on TextButton,
            -- but we can scale-pulse + color flash as the animation instead
            local t = i / steps
            local scale = 1 + 0.35 * math.sin(t * math.pi)
            guiToggleBtn.TextSize = math.floor(26 * scale)
            task.wait(stepTime)
        end
        guiToggleBtn.TextSize = 26
        isSpinning = false
    end)
end

