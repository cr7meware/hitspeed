-- HITBOX LOGIC
-- Store original HRP state before we touch anything so reset is pixel-perfect
local originalHRPState = {}
local targets = {}

local function saveOriginalHRP(p)
    local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    if hrp and not originalHRPState[p] then
        originalHRPState[p] = {
            Size         = hrp.Size,
            Transparency = hrp.Transparency,
            Material     = hrp.Material,
            BrickColor   = hrp.BrickColor,
            CanCollide   = hrp.CanCollide,
        }
    end
end

local function updateTargets()
    targets = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(targets, p)
        end
    end
end

local function applyHitboxes()
    for _, p in ipairs(targets) do
        local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            saveOriginalHRP(p)  -- capture before first modification
            local size = math.clamp(tonumber(hitboxSizeBox.Text) or 7, 1, 10)
            hrp.Size        = Vector3.new(size, size, size)
            hrp.Transparency = tonumber(transparencyBox.Text) or 0.9
            hrp.Material    = Enum.Material.Neon
            hrp.CanCollide  = false
            hrp.BrickColor  = BrickColor.new("Really black")
        end
    end
end

function resetHitboxes()
    -- Restore every player we ever touched using saved original state
    for p, orig in pairs(originalHRPState) do
        pcall(function()
            local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Size         = orig.Size
                hrp.Transparency = orig.Transparency
                hrp.Material     = orig.Material
                hrp.BrickColor   = orig.BrickColor
                hrp.CanCollide   = orig.CanCollide
            end
        end)
    end
    -- Also sweep current targets in case any weren't in the saved table
    for _, p in ipairs(targets) do
        pcall(function()
            local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if hrp and not originalHRPState[p] then
                hrp.Size         = Vector3.new(2, 2, 1)
                hrp.Transparency = 0
                hrp.Material     = Enum.Material.SmoothPlastic
                hrp.BrickColor   = BrickColor.new("Medium stone grey")
                hrp.CanCollide   = true
            end
        end)
    end
    originalHRPState = {}
end

-- Clear saved state when a player's character resets so we capture fresh values next time
Players.PlayerRemoving:Connect(function(p) originalHRPState[p] = nil end)
Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        originalHRPState[plr] = nil  -- fresh character, drop stale saved state
        task.wait(1)
        if hitboxEnabled then applyHitboxes() end
    end)
end)
for _, plr in pairs(Players:GetPlayers()) do
    plr.CharacterAdded:Connect(function()
        originalHRPState[plr] = nil
        task.wait(1)
        if hitboxEnabled then applyHitboxes() end
    end)
end

